NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Supabase Storage (Educational Materials only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side ONLY variables (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
AGNES_API_KEY=your_agnes_api_key_here
AGNES_MODEL=agnes-3.0-flash
AGNES_API_URL=https://api.agnes.ai/v1
AGNES_REQUEST_TIMEOUT_MS=30000
AGNES_MAX_RETRIES=3
ADMIN_PROVISIONING_SECRET=your_secure_admin_provisioning_secret_here
